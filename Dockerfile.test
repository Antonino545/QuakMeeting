FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV QT_QPA_PLATFORM=offscreen

WORKDIR /app
COPY . /app

# Install build dependencies
RUN apt-get update && \
    apt-get install -y software-properties-common && \
    add-apt-repository universe && \
    apt-get update && \
    apt-get install -y dpkg-dev python3-pip xvfb libegl1 libgl1 fakeroot python3-gi gir1.2-edataserver-1.2 gir1.2-ecal-2.0 && \
    pip3 install PyQt6 pytest pytest-qt pytest-xvfb psutil requests setuptools

# Build the .deb package inside the container
RUN chmod +x ./scripts/build_ubuntu_deb.sh && ./scripts/build_ubuntu_deb.sh

# Install the generated .deb package
RUN apt-get install -y /app/deb_dist/*.deb

# Run the test suite via xvfb
CMD ["xvfb-run", "-a", "python3", "-m", "pytest", "tests/", "-v"]
